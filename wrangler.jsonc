{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "p2-transfer",
  "main": "worker/signaling.js",
  "compatibility_date": "2026-07-29",
  "assets": {
    "directory": "dist"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SIGNAL_ROOM",
        "class_name": "SignalRoom"
      }
    ]
  },
  "exports": {
    "SignalRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
