{
  "name": "p2-transfer",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Peer-to-peer file transfer via WebRTC",
  "scripts": {
    "dev": "concurrently -n signal,web -c cyan,magenta \"wrangler dev --port 8787\" \"vite --host 0.0.0.0\"",
    "dev:web": "vite --host 0.0.0.0",
    "dev:signal": "wrangler dev --port 8787",
    "build": "tsc && vite build",
    "test:e2e": "playwright test",
    "preview": "vite preview --host 0.0.0.0",
    "deploy:signal": "wrangler deploy"
  },
  "dependencies": {
    "@fontsource-variable/roboto-flex": "^5.3.0",
    "@material-symbols/svg-400": "^0.45.9",
    "@material/web": "^2.5.0",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "concurrently": "^10.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "wrangler": "^4.114.0"
  }
}
